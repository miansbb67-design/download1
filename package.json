{
  "name": "downloadpro",
  "version": "1.0.0",
  "description": "DownloadPro - Advanced IDM-Style Video & Audio Downloader",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "web": "php -S 127.0.0.1:8000",
    "package": "electron-builder --win"
  },
  "keywords": [
    "downloader",
    "idm",
    "video-downloader",
    "audio-downloader",
    "electron"
  ],
  "author": "DownloadPro Team",
  "license": "MIT",
  "build": {
    "appId": "com.downloadpro.app",
    "productName": "DownloadPro",
    "directories": {
      "output": "dist-release"
    },
    "files": [
      "assets/**/*",
      "app/**/*",
      "api/**/*",
      "engine/**/*",
      "electron/**/*",
      "index.php",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DownloadPro"
    }
  }
}
