APP_NAME=FlowFetch
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost/download1

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=download1_db
DB_USERNAME=root
DB_PASSWORD=

PYTHON_PATH=python
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
YTDLP_PATH=yt-dlp

STORAGE_PATH=c:/xampp/htdocs/download1/storage
MAX_CONCURRENT_DOWNLOADS=4
RETENTION_HOURS=48
RATE_LIMIT_PER_MINUTE=60
BLOCK_PRIVATE_IPS=true

